{
    "manifest_version": 3,
    "name": "Handle",
    "version": "1.11.0",
    "description": "Gives Handle a sturdier view of your open Chrome tabs: native tab groups, race-free screenshots, console errors, and a search index of the pages you read. Talks to Handle's local server (127.0.0.1:4910) and, if you link this browser in Options, to one other computer's Handle over your tailnet.",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "scripting",
        "debugger",
        "alarms",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:4910/*",
        "<all_urls>"
    ],
    "minimum_chrome_version": "116",
    "commands": {
        "tab-next": {
            "suggested_key": {
                "default": "Alt+Right",
                "mac": "Alt+Right"
            },
            "description": "Next tab in this window"
        },
        "tab-prev": {
            "suggested_key": {
                "default": "Alt+Left",
                "mac": "Alt+Left"
            },
            "description": "Previous tab in this window"
        }
    },
    "action": {
        "default_title": "Handle"
    },
    "options_page": "options.html"
}